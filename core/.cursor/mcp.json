{
    "mcpServers": {
      "github-mcp": {
        "command": "npx",
        "args": [
          "-y",
          "@composio/mcp-server-github"
        ],
        "env": {
          "GITHUB_TOKEN": "your_github_pat_here"
        }
      },
      "linear-mcp": {
        "command": "npx",
        "args": [
          "-y",
          "@composio/mcp-server-linear"
        ],
        "env": {
          "LINEAR_API_KEY": "your_linear_api_key_here"
        }
      },
      "playwright-mcp": {
        "command": "npx",
        "args": [
          "-y",
          "@composio/mcp-server-playwright"
        ]
      }
    }
  }